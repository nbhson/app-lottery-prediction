# ============================================================
# AI Configuration — OpenAI-compatible API
# ============================================================
# Provider: openai | openrouter | groq | deepseek | upstage | custom
AI_PROVIDER=openrouter
AI_API_KEY=your_api_key_here
# Base URL cho OpenRouter/Groq/DeepSeek/Upstage/custom endpoint
# (bỏ trống → tự dùng mặc định theo provider, VD upstage: https://api.upstage.ai/v1)
AI_BASE_URL=https://openrouter.ai/api/v1
# Model name (VD: gpt-4o-mini, meta-llama/llama-3-8b-instruct, solar-pro4)
AI_MODEL=gpt-4o-mini
# Temperature cho AI response (0-2)
AI_TEMPERATURE=0.7
# Timeout cho AI API (ms)
AI_TIMEOUT_MS=30000
# ============================================================
# Data Source Configuration
# ============================================================
# Nguồn dữ liệu chính: vietlott_en | vietlott_vn | custom_api
DATA_SOURCE=vietlott_en
# URL tùy chỉnh (nếu DATA_SOURCE=custom_api)
DATA_SOURCE_URL=
# Interval đồng bộ dữ liệu (phút) — auto-sync chạy lúc app khởi động + theo chu kỳ
DATA_SYNC_INTERVAL_MINUTES=30
# Retry khi fetch fail
FETCH_MAX_RETRIES=3
FETCH_RETRY_DELAY_MS=2000
# Thư mục chứa SQLite DB (mặc định: <project>/data)
DATA_DIR=
# Token bảo vệ POST /api/sync (khuyến nghị khi deploy public).
# Khi đặt: request POST phải kèm header x-api-token hoặc Authorization: Bearer <token>.
# Bỏ trống → sync mở cho mọi người (rate limit vẫn bảo vệ) — chỉ dùng cho dev.
SYNC_API_TOKEN=
# Bật khi chạy sau reverse proxy đáng tin (nginx/Cloudflare/Vercel) để rate-limit
# nhận đúng IP thật từ X-Forwarded-For. KHÔNG bật nếu client có thể tự đặt header
# (khi đó per-IP limit gộp về 1 bucket — global cap vẫn bảo vệ route đắt tiền).
TRUST_PROXY=0
# ============================================================
# Rate Limit — Redis (tùy chọn, multi-instance)
# ============================================================
# Set REDIS_URL để chia sẻ bucket rate-limit qua nhiều instance
# (vd: redis://localhost:6379 hoặc redis://default:pass@host:6379).
# Không set → in-memory sliding-window (đủ cho single instance).
# Redis chết giữa chừng → tự fallback in-memory, không làm sập request.
REDIS_URL=
# ============================================================
# App Configuration
# ============================================================
NODE_ENV=development
